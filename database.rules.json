{
  "rules": {
    ".read": "auth != null",
    ".write": "false",

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "ownerUidMap": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "owners": {
      "$ownerId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId || (!data.exists() && newData.child('uid').val() === auth.uid) || (!data.child('uid').exists() && newData.child('uid').val() === auth.uid))"
      }
    },

    "petsByOwner": {
      "$ownerId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId)"
      }
    },

    "selectedPetByOwner": {
      "$ownerId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('ownerUidMap').child(auth.uid).val() === $ownerId)"
      }
    },

    "medicalRecordsByPet": {
      "$petId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
      }
    },

    "emailIndex": {
      "$emailKey": {
        ".read": "true",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || !data.exists())"
      }
    },

    "phoneIndex": {
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || !data.exists())"
      }
    },

    "auditTrail": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null",
      "$recordId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
